#!/bin/bash

set -u

LABEL="com.glosh.ai-autorun"
POLL_SECONDS=45
REMOTE_BRANCH="origin/coordination/ai-control"
TICKET_PATH="docs/AI_NEXT_TICKET.md"
DEFAULT_CODEX="/Applications/ChatGPT.app/Contents/Resources/codex"

runtime_home() {
  if [ -n "${GLOSH_AI_AUTORUN_HOME:-}" ]; then
    printf '%s\n' "$GLOSH_AI_AUTORUN_HOME"
  else
    printf '%s\n' "${HOME:?}/Library/Application Support/Glosh/ai-autorun"
  fi
}

RUNTIME_HOME="$(runtime_home)"
STATE_FILE="$RUNTIME_HOME/state"
LOCK_DIR="$RUNTIME_HOME/run.lock"
CONFIG_FILE="$RUNTIME_HOME/config"
LOG_DIR="$RUNTIME_HOME/logs"
RUN_LOG="$LOG_DIR/runner.log"
EXEC_LOG="$LOG_DIR/codex-exec.log"
INSTALL_DIR="$RUNTIME_HOME/bin"
INSTALLED_RUNNER="$INSTALL_DIR/glosh-ai-autorun"
LAUNCH_AGENT="${HOME:?}/Library/LaunchAgents/$LABEL.plist"

now() {
  date -u '+%Y-%m-%dT%H:%M:%SZ'
}

sanitize_value() {
  printf '%s' "$1" | tr '\n\r=' '   ' | cut -c 1-240
}

state_get() {
  key="$1"
  [ -f "$STATE_FILE" ] || return 0
  awk -F= -v wanted="$key" '$1 == wanted {sub(/^[^=]*=/, ""); print; exit}' "$STATE_FILE"
}

write_state() {
  mkdir -p "$RUNTIME_HOME" "$LOG_DIR"
  umask 077
  tmp="$STATE_FILE.tmp.$$"
  {
    printf 'detected_sha=%s\n' "$(sanitize_value "${DETECTED_SHA:-}")"
    printf 'executed_sha=%s\n' "$(sanitize_value "${EXECUTED_SHA:-}")"
    printf 'ticket_id=%s\n' "$(sanitize_value "${TICKET_ID:-}")"
    printf 'status=%s\n' "$(sanitize_value "${RUN_STATUS:-idle}")"
    printf 'pid=%s\n' "$(sanitize_value "${RUN_PID:-}")"
    printf 'detected_at=%s\n' "$(sanitize_value "${DETECTED_AT:-}")"
    printf 'started_at=%s\n' "$(sanitize_value "${STARTED_AT:-}")"
    printf 'finished_at=%s\n' "$(sanitize_value "${FINISHED_AT:-}")"
    printf 'last_exit=%s\n' "$(sanitize_value "${LAST_EXIT:-}")"
    printf 'log_path=%s\n' "$(sanitize_value "$EXEC_LOG")"
  } > "$tmp"
  mv "$tmp" "$STATE_FILE"
}

load_state() {
  DETECTED_SHA="$(state_get detected_sha)"
  EXECUTED_SHA="$(state_get executed_sha)"
  TICKET_ID="$(state_get ticket_id)"
  RUN_STATUS="$(state_get status)"
  RUN_PID="$(state_get pid)"
  DETECTED_AT="$(state_get detected_at)"
  STARTED_AT="$(state_get started_at)"
  FINISHED_AT="$(state_get finished_at)"
  LAST_EXIT="$(state_get last_exit)"
  [ -n "$RUN_STATUS" ] || RUN_STATUS="idle"
}

config_get() {
  key="$1"
  [ -f "$CONFIG_FILE" ] || return 0
  awk -F= -v wanted="$key" '$1 == wanted {sub(/^[^=]*=/, ""); print; exit}' "$CONFIG_FILE"
}

log_line() {
  mkdir -p "$LOG_DIR"
  rotate_log "$RUN_LOG"
  printf '%s %s\n' "$(now)" "$*" >> "$RUN_LOG"
}

rotate_log() {
  file="$1"
  [ -f "$file" ] || return 0
  size="$(wc -c < "$file" | tr -d ' ')"
  if [ "${size:-0}" -gt 1048576 ]; then
    mv "$file" "$file.1"
  fi
}

acquire_lock() {
  mkdir -p "$RUNTIME_HOME"
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    lock_pid=""
    [ -f "$LOCK_DIR/pid" ] && lock_pid="$(sed -n '1p' "$LOCK_DIR/pid")"
    if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
      return 1
    fi
    rm -rf "$LOCK_DIR"
    mkdir "$LOCK_DIR" 2>/dev/null || return 1
    log_line "recovered stale_lock"
  fi
  printf '%s\n' "$$" > "$LOCK_DIR/pid"
  trap 'rm -rf "$LOCK_DIR"' EXIT HUP INT TERM
  return 0
}

load_ticket() {
  repo="$(config_get repo)"
  ticket_tmp="$RUNTIME_HOME/ticket.current.$$"
  if [ -n "${GLOSH_AI_AUTORUN_TEST_TICKET:-}" ]; then
    cp "$GLOSH_AI_AUTORUN_TEST_TICKET" "$ticket_tmp"
    mv "$ticket_tmp" "$RUNTIME_HOME/ticket.current"
    CURRENT_SHA="${GLOSH_AI_AUTORUN_TEST_SHA:-$(shasum -a 256 "$RUNTIME_HOME/ticket.current" | awk '{print $1}')}"
    return 0
  fi
  if [ -z "$repo" ] || [ ! -d "$repo/.git" ]; then
    log_line "failed config_missing_or_repo_invalid"
    return 1
  fi
  if ! git -C "$repo" fetch --quiet origin "+refs/heads/coordination/ai-control:refs/remotes/origin/coordination/ai-control"; then
    log_line "failed git_fetch"
    return 1
  fi
  CURRENT_SHA="$(git -C "$repo" rev-parse "$REMOTE_BRANCH:$TICKET_PATH" 2>/dev/null)" || return 1
  if ! git -C "$repo" show "$REMOTE_BRANCH:$TICKET_PATH" > "$ticket_tmp"; then
    rm -f "$ticket_tmp"
    return 1
  fi
  mv "$ticket_tmp" "$RUNTIME_HOME/ticket.current"
}

ticket_id_from_file() {
  awk '/^##[[:space:]]+/ {sub(/^##[[:space:]]+/, ""); print; exit}' "$RUNTIME_HOME/ticket.current" |
    tr -cd 'A-Za-z0-9._/-\n' |
    cut -c 1-120
}

execute_ticket() {
  repo="$(config_get repo)"
  codex_bin="$(config_get codex_bin)"
  [ -n "$codex_bin" ] || codex_bin="$DEFAULT_CODEX"
  if [ "${GLOSH_AI_AUTORUN_TEST_MODE:-0}" = "1" ]; then
    printf '%s %s\n' "$CURRENT_SHA" "$CURRENT_TICKET_ID" >> "${GLOSH_AI_AUTORUN_TEST_EXEC_LOG:?}"
    sleep "${GLOSH_AI_AUTORUN_TEST_SLEEP:-0}"
    return "${GLOSH_AI_AUTORUN_TEST_EXIT:-0}"
  fi
  if [ ! -x "$codex_bin" ]; then
    log_line "failed codex_not_executable"
    return 127
  fi
  rotate_log "$EXEC_LOG"
  prompt="Ejecución automática autorizada únicamente para el ticket vigente. Leé docs/AI_WORKFLOW.md y docs/AI_NEXT_TICKET.md desde origin/coordination/ai-control, ejecutá exactamente ese ticket y ningún otro. Respetá sus ramas, límites, prohibiciones y gates. El trigger automático no autoriza Production, despliegues, merges, borrados destructivos, gastos, pruebas físicas ni envío de APK salvo autorización explícita del usuario en el ticket/chat vigente. Dejá la PR y/o docs/AI_CODEX_HANDOFF.md exigidos en GitHub y detenete al terminar o bloquearte."
  "$codex_bin" exec --approve-for-me --cd "$repo" "$prompt" >> "$EXEC_LOG" 2>&1
}

poll() {
  if ! acquire_lock; then
    log_line "skip single_flight_lock_busy"
    return 0
  fi
  load_state
  if ! load_ticket; then
    RUN_STATUS="failed"
    LAST_EXIT="ticket_fetch_failed"
    FINISHED_AT="$(now)"
    RUN_PID=""
    write_state
    return 1
  fi
  CURRENT_TICKET_ID="$(ticket_id_from_file)"
  if [ -z "$CURRENT_TICKET_ID" ]; then
    RUN_STATUS="blocked"
    LAST_EXIT="ticket_id_missing"
    FINISHED_AT="$(now)"
    write_state
    log_line "blocked ticket_id_missing sha=$CURRENT_SHA"
    return 1
  fi
  DETECTED_SHA="$CURRENT_SHA"
  TICKET_ID="$CURRENT_TICKET_ID"
  DETECTED_AT="$(now)"
  if [ "$CURRENT_SHA" = "$EXECUTED_SHA" ]; then
    write_state
    log_line "skip duplicate sha=$CURRENT_SHA ticket=$CURRENT_TICKET_ID"
    return 0
  fi
  EXECUTED_SHA="$CURRENT_SHA"
  RUN_STATUS="running"
  RUN_PID="$$"
  STARTED_AT="$(now)"
  FINISHED_AT=""
  LAST_EXIT=""
  write_state
  log_line "start sha=$CURRENT_SHA ticket=$CURRENT_TICKET_ID pid=$$"
  execute_ticket
  rc=$?
  load_state
  RUN_PID=""
  FINISHED_AT="$(now)"
  LAST_EXIT="$rc"
  if [ "$rc" -eq 0 ]; then
    RUN_STATUS="completed"
    log_line "completed sha=$CURRENT_SHA ticket=$CURRENT_TICKET_ID"
  else
    RUN_STATUS="failed"
    log_line "failed sha=$CURRENT_SHA ticket=$CURRENT_TICKET_ID exit=$rc"
  fi
  write_state
  return "$rc"
}

mark_current() {
  if ! acquire_lock; then
    return 1
  fi
  load_state
  load_ticket || return 1
  CURRENT_TICKET_ID="$(ticket_id_from_file)"
  [ -n "$CURRENT_TICKET_ID" ] || return 1
  DETECTED_SHA="$CURRENT_SHA"
  EXECUTED_SHA="$CURRENT_SHA"
  TICKET_ID="$CURRENT_TICKET_ID"
  RUN_STATUS="completed"
  RUN_PID=""
  DETECTED_AT="$(now)"
  STARTED_AT=""
  FINISHED_AT="$(now)"
  LAST_EXIT="marked_processed_at_install"
  write_state
  log_line "marked_processed sha=$CURRENT_SHA ticket=$CURRENT_TICKET_ID"
}

write_config() {
  repo="$1"
  codex_bin="$2"
  mkdir -p "$RUNTIME_HOME" "$LOG_DIR"
  umask 077
  {
    printf 'repo=%s\n' "$repo"
    printf 'codex_bin=%s\n' "$codex_bin"
  } > "$CONFIG_FILE"
}

write_plist() {
  mkdir -p "$(dirname "$LAUNCH_AGENT")"
  umask 077
  {
    printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>'
    printf '%s\n' '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
    printf '%s\n' '<plist version="1.0"><dict>'
    printf '%s\n' '  <key>Label</key><string>com.glosh.ai-autorun</string>'
    printf '%s\n' '  <key>ProgramArguments</key><array>'
    printf '    <string>%s</string>\n' "$INSTALLED_RUNNER"
    printf '%s\n' '    <string>poll</string>'
    printf '%s\n' '  </array>'
    printf '%s\n' '  <key>RunAtLoad</key><true/>'
    printf '  <key>StartInterval</key><integer>%s</integer>\n' "$POLL_SECONDS"
    printf '%s\n' '  <key>ProcessType</key><string>Background</string>'
    printf '  <key>StandardOutPath</key><string>%s</string>\n' "$RUN_LOG"
    printf '  <key>StandardErrorPath</key><string>%s</string>\n' "$RUN_LOG"
    printf '%s\n' '</dict></plist>'
  } > "$LAUNCH_AGENT"
  plutil -lint "$LAUNCH_AGENT" >/dev/null
}

service_target() {
  printf 'gui/%s/%s\n' "$(id -u)" "$LABEL"
}

service_loaded() {
  launchctl print "$(service_target)" >/dev/null 2>&1
}

start_service() {
  if service_loaded; then
    launchctl kickstart "$(service_target)" >/dev/null
  else
    launchctl bootstrap "gui/$(id -u)" "$LAUNCH_AGENT"
  fi
}

stop_service() {
  if service_loaded; then
    launchctl bootout "$(service_target)" >/dev/null
  fi
  load_state
  if [ -n "$RUN_PID" ] && kill -0 "$RUN_PID" 2>/dev/null; then
    kill "$RUN_PID" 2>/dev/null || true
    RUN_STATUS="blocked"
    RUN_PID=""
    FINISHED_AT="$(now)"
    LAST_EXIT="stopped_by_user"
    write_state
  fi
}

install_service() {
  repo="${1:-$(git rev-parse --show-toplevel 2>/dev/null || true)}"
  if [ -z "$repo" ] || [ ! -d "$repo/.git" ]; then
    printf 'ERROR: repo inválido: %s\n' "$repo" >&2
    return 2
  fi
  codex_bin="$(command -v codex 2>/dev/null || true)"
  [ -x "$codex_bin" ] || codex_bin="$DEFAULT_CODEX"
  if [ ! -x "$codex_bin" ]; then
    printf 'ERROR: codex exec no está disponible.\n' >&2
    return 2
  fi
  first_install=0
  [ -f "$STATE_FILE" ] || first_install=1
  stop_service
  mkdir -p "$INSTALL_DIR" "$LOG_DIR"
  install_tmp="$INSTALLED_RUNNER.tmp.$$"
  cp "$0" "$install_tmp"
  chmod 700 "$install_tmp"
  mv "$install_tmp" "$INSTALLED_RUNNER"
  write_config "$repo" "$codex_bin"
  write_plist
  if [ "$first_install" -eq 1 ]; then
    "$INSTALLED_RUNNER" mark-current
  fi
  start_service
  printf 'Instalado: %s\n' "$LABEL"
  status_service
}

status_service() {
  load_state
  if service_loaded; then service="active"; else service="inactive"; fi
  printf 'service=%s\n' "$service"
  printf 'ticket=%s\n' "${TICKET_ID:-}"
  printf 'detected_sha=%s\n' "${DETECTED_SHA:-}"
  printf 'executed_sha=%s\n' "${EXECUTED_SHA:-}"
  printf 'status=%s\n' "${RUN_STATUS:-idle}"
  printf 'pid=%s\n' "${RUN_PID:-}"
  printf 'started_at=%s\n' "${STARTED_AT:-}"
  printf 'finished_at=%s\n' "${FINISHED_AT:-}"
  printf 'last_exit=%s\n' "${LAST_EXIT:-}"
  printf 'log=%s\n' "$EXEC_LOG"
  printf 'state=%s\n' "$STATE_FILE"
  printf 'lock=%s\n' "$LOCK_DIR"
}

uninstall_service() {
  stop_service
  rm -f "$LAUNCH_AGENT" "$INSTALLED_RUNNER"
  printf 'Desinstalado. Estado y logs preservados en: %s\n' "$RUNTIME_HOME"
}

usage() {
  printf 'Uso: %s install [repo] | status | start | stop | run-once | uninstall\n' "$0"
}

command="${1:-}"
case "$command" in
  install) install_service "${2:-}" ;;
  status) status_service ;;
  start) start_service; status_service ;;
  stop) stop_service; status_service ;;
  run-once|poll) poll ;;
  mark-current) mark_current ;;
  uninstall) uninstall_service ;;
  *) usage; exit 2 ;;
esac

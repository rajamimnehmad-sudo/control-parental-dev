{
  "manifest_version": 3,
  "name": "Glosh Chrome Android Provenance Lab",
  "version": "0.1.0",
  "minimum_chrome_version": "146",
  "key": "",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "storage",
    "tabs",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "https://glosh-photos.test/*",
    "http://127.0.0.1:8765/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://glosh-photos.test/*"],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "ISOLATED"
    }
  ]
}

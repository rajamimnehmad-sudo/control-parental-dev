+    private fun scheduleCapture(
+        epoch: Long,
+        trigger: String,
+        motion: Boolean,
+    ) {
+        synchronized(jobLock) { activeJob?.cancel() }
+        var scheduled: Job? = null
+        scheduled =
+            scope.launch {
+                try {
+                    delay(if (motion) MotionQuietMillis else ContentQuietMillis)

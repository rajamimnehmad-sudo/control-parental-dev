<resources>
    <style
        name="Theme.DagBrowser"
        parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/dag_navy</item>
        <item name="android:colorAccent">@color/dag_blue</item>
        <item name="android:navigationBarColor">@color/dag_navy</item>
        <item name="android:statusBarColor">@color/dag_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.DagBrowser.Fullscreen" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/dag_background</item>
        <item name="android:colorAccent">@color/dag_blue</item>
    </style>
</resources>

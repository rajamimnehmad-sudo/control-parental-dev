<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dag_background"
    android:orientation="vertical"
    android:paddingTop="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/downloads"
                android:textColor="@color/dag_text"
                android:textSize="26sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/downloads_subtitle"
                android:textColor="@color/dag_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/downloads_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/dag_switcher_button_background"
            android:contentDescription="@string/close"
            android:padding="12dp"
            android:src="@drawable/ic_dag_close" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/downloads_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp" />

    <TextView
        android:id="@+id/downloads_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="36dp"
        android:text="@string/downloads_empty"
        android:textColor="@color/dag_muted"
        android:textSize="17sp"
        android:visibility="gone" />
</LinearLayout>

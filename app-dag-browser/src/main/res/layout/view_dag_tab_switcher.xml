<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dag_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/tab_switcher_header"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/dag_chrome"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/tab_switcher_new"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/dag_switcher_button_background"
            android:contentDescription="@string/new_tab"
            android:padding="11dp"
            android:src="@drawable/ic_dag_add" />

        <TextView
            android:id="@+id/tab_switcher_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/dag_text"
            android:textSize="19sp" />

        <ImageButton
            android:id="@+id/tab_switcher_done"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/dag_switcher_button_background"
            android:contentDescription="@string/close_tab_switcher"
            android:padding="12dp"
            android:src="@drawable/ic_dag_close" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:text="@string/tab_switcher_hint"
        android:textColor="@color/dag_muted"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tab_switcher_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="18dp"
        android:scrollbars="vertical" />

    <Button
        android:id="@+id/tab_switcher_close_all"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/dag_status_error"
        android:fontFamily="sans-serif-medium"
        android:text="@string/close_all_tabs"
        android:textAllCaps="false"
        android:textColor="@color/dag_status_error_text"
        android:textSize="15sp" />
</LinearLayout>

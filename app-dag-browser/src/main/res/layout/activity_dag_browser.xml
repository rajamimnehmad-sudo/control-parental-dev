<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dag_navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <Button
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/back"
            android:enabled="false"
            android:text="@string/back_symbol"
            android:textSize="26sp" />

        <EditText
            android:id="@+id/address_input"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@color/dag_surface"
            android:hint="@string/address_hint"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:importantForAutofill="no"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:selectAllOnFocus="true"
            android:textColor="@color/dag_text"
            android:textColorHint="@color/dag_muted" />

        <Button
            android:id="@+id/go_button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/go" />

        <Button
            android:id="@+id/reload_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/reload"
            android:text="@string/reload_symbol"
            android:textSize="20sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.mozilla.geckoview.GeckoView
            android:id="@+id/gecko_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/dag_background"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/safety_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/dag_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ProgressBar
                android:id="@+id/safety_progress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/safety_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/preparing_protection"
                android:textColor="@color/dag_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/safety_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/dag_muted"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/browser_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/browser_shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/browser_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/dag_chrome"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <ImageButton
                android:id="@+id/new_page_button"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/dag_toolbar_button_background"
                android:contentDescription="@string/new_page"
                android:enabled="false"
                android:padding="10dp"
                android:src="@drawable/ic_dag_add" />

            <RelativeLayout
                android:id="@+id/address_bar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/dag_address_background"
                android:elevation="2dp"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">

                <ImageButton
                    android:id="@+id/security_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/security_status"
                    android:padding="7dp"
                    android:src="@drawable/ic_dag_shield" />

                <EditText
                    android:id="@+id/address_input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@id/go_button"
                    android:layout_toEndOf="@id/security_button"
                    android:background="@android:color/transparent"
                    android:hint="@string/address_hint"
                    android:imeOptions="actionGo"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingStart="7dp"
                    android:paddingEnd="3dp"
                    android:selectAllOnFocus="true"
                    android:textColor="@color/dag_text"
                    android:textColorHint="@color/dag_muted"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/go_button"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/dag_search_icon_background"
                    android:contentDescription="@string/search"
                    android:padding="7dp"
                    android:src="@drawable/ic_dag_search" />
            </RelativeLayout>

        <TextView
            android:id="@+id/tab_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/dag_tab_button_background"
            android:contentDescription="@string/tabs"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/initial_tab_count"
            android:textColor="@color/dag_text"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/menu_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/dag_toolbar_button_background"
            android:contentDescription="@string/browser_menu"
            android:padding="10dp"
            android:src="@drawable/ic_dag_more"
            android:tint="@color/dag_text" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/page_load_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:indeterminate="false"
            android:max="100"
            android:maxHeight="2dp"
            android:minHeight="2dp"
            android:progressBackgroundTint="@android:color/transparent"
            android:progressTint="@color/dag_blue"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/browser_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/dag_surface"
            android:layout_weight="1">

        <com.contentfilter.dagbrowser.DagGeckoView
            android:id="@+id/gecko_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/dag_background"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/navigation_snapshot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/video_lab_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/dag_navy"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="noHideDescendants"
            android:visibility="gone">

            <ImageView
                android:id="@+id/video_lab_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:visibility="gone" />

            <TextView
                android:id="@+id/video_lab_cover_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="12dp"
                android:gravity="center"
                android:text="@string/video_lab_cover_active"
                android:textColor="@color/dag_on_navy"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/video_lab_fullscreen_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/dag_overlay_icon_background"
                android:contentDescription="@string/video_fullscreen"
                android:elevation="8dp"
                android:padding="10dp"
                android:src="@drawable/ic_dag_fullscreen"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/safety_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/dag_background"
            android:padding="24dp">

            <LinearLayout
                android:id="@+id/safety_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/dag_overlay_card_background"
                android:elevation="6dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="28dp"
                android:paddingEnd="28dp"
                android:paddingBottom="28dp">

                <ImageView
                    android:id="@+id/safety_icon"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/dag_overlay_icon_background"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_dag_shield" />

                <View
                    android:id="@+id/safety_shimmer"
                    android:layout_width="96dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/dag_loading_shimmer"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/safety_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="22dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/dag_blue" />

                <TextView
                    android:id="@+id/safety_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/preparing_protection"
                    android:textColor="@color/dag_text"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/safety_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/dag_muted"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <com.contentfilter.dagbrowser.DagTabSwitcherView
        android:id="@+id/tab_switcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="12dp" />
</FrameLayout>
